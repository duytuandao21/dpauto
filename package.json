{
  "name": "hyperauto-care-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 4001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 4001",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "content:import": "node scripts/import-reference.mjs",
    "format": "prettier --write src scripts tests next.config.ts package.json tsconfig.json README.md docs/*.md",
    "check:browser": "node scripts/check-browser.cjs"
  },
  "dependencies": {
    "motion": "14.8.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
