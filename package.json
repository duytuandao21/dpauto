{
  "name": "dpauto-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "api:dev": "npm --prefix backend run dev",
    "api:start": "npm --prefix backend start",
    "api:migrate": "npm --prefix backend run db:migrate",
    "api:bootstrap": "npm --prefix backend run db:bootstrap",
    "dev": "next dev --hostname 0.0.0.0 --port 4001",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 4001",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "content:import": "node scripts/import-reference.mjs",
    "format": "prettier --write src scripts tests next.config.ts package.json tsconfig.json README.md docs/*.md",
    "check:browser": "node scripts/check-browser.cjs"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-text-align": "3.34.0",
    "@tiptap/extension-youtube": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "motion": "14.8.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
