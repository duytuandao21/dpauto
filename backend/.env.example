NODE_ENV=development
DATABASE_URL=postgresql://dpauto:REPLACE_PASSWORD@127.0.0.1:5432/dpauto
API_HOST=127.0.0.1
API_PORT=4002
APP_ORIGIN=http://localhost:4001
# Additional frontend origins, comma-separated; APP_ORIGIN is always allowed.
APP_ALLOWED_ORIGINS=
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
API_SECRET=
STATION_CODE=TOAN_TRUNG

# Required once for db:bootstrap; remove BOOTSTRAP_PASSWORD afterwards.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
STATION_NAME=Trạm dịch vụ Toàn Trung
STATION_PHONE=0772 584 279
STATION_ADDRESS=
STATION_DIRECTIONS_URL=

# Website images (CMS). local = dev/test disk under MEDIA_LOCAL_DIR; r2 = Cloudflare R2.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=storage/media
# r2: https://pub-xxxx.r2.dev now, https://img.<domain> later. local: leave empty.
MEDIA_PUBLIC_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=dpauto-media
R2_BUCKET_ORIGINALS=dpauto-media-originals
